# Copy to .env on YOUR server. NEVER put these in GitHub or send them in chat.
MODE=live
PORT=3000
DATA_DIR=./data
PUBLIC_URL=https://your-domain.com
ADMIN_PHONE=08133515448
ADMIN_PASSWORD=choose-a-long-password
ADMIN_PIN=0000
SUPPORT_PHONE=08133515448
# VTpass (start with sandbox!)
VTPASS_BASE=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# JSON maps from YOUR plan ids to VTpass codes, e.g. {"mtn-SME-1GB":{"serviceID":"mtn-data","code":"mtn-1gb"}}
VTPASS_PLANMAP={}
VTPASS_DISCOMAP={}
VTPASS_CABLEMAP={}
# Paystack (start with test keys sk_test_...)
PAYSTACK_SECRET_KEY=
